# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Unit test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environments
.env
venv/
ENV/

# Environment-matrix output. Per-row diagnose JSON is transient -- the artefact worth
# keeping is backends.json plus the regenerated docs/backends.md table, and those are
# produced by tools/render_backends.py and committed deliberately.
out/

# Editor / OS
.DS_Store
# vim swap files, named `.<file>.swp` beside the file being edited -- so they sit in the tree
# while an editor is open and are trivially swept up by `git add -A`. The [a-p] range covers the
# .swo/.swn/... names vim falls back to when .swp is taken.
*.sw[a-p]
